@model List<DotNetRESTfulCraze.Models.Product>

<h2>Products</h2>

@if (Model != null && Model.Count > 0)
{
    <table class="table table-bordered">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Price</th>
        </tr>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Name</td>
                <td>@p.Price</td>
            </tr>
        }
    </table>
}
else
{
    <p>No products found.</p>
}
